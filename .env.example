# Copy to .env and fill in. .env is gitignored and Claude Code sessions are
# blocked from reading it (.claude/settings.json). docker compose reads it for
# the values below; only the worker container receives the file itself, since
# the worker is the only process that calls Claude.

# mock | anthropic. mock runs the whole stack with the mock LLM and needs no
# key. There is no silent fallback: with "anthropic" and an empty key, the
# worker refuses to start.
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Bearer token for every /api request. This is a dev token for a local stack
# with a mock provider; docker compose uses the same default when it is unset.
# The API refuses to start without a token unless ALLOW_UNAUTHENTICATED=true.
ADMIN_TOKEN=dev-admin-token

# Hosts a campaign_url may point at (comma separated, https only, no port).
CAMPAIGN_URL_HOSTS=shop.example

# Demo: make the mock LLM's first answer of each stage invalid, to show the
# repair loop.
MOCKLLM_INVALID_FIRST=false

# Mock provider chaos (shares of requests, 0 to 1). Compose defaults:
# 5% 500, 5% 503, 5% 429, 3% send-then-drop, 2% hang, 20ms latency.
# MOCKPROVIDER_RATE_500=0.05
# MOCKPROVIDER_RATE_503=0.05
# MOCKPROVIDER_RATE_429=0.05
# MOCKPROVIDER_RATE_DROP=0.03
# MOCKPROVIDER_RATE_HANG=0.02
