[
  {
    "name": "istanbul_cart_abandoners",
    "category": "cart_abandoners",
    "brief": "Son 30 günde sepetine ürün ekleyip alışveriş yapmayan İstanbul'daki kullanıcılara %30 indirim hatırlatması gönder.",
    "expect": {
      "match": "all",
      "conditions": [
        { "kind": "enum_attribute", "field": "city", "op": "eq", "value": "istanbul" },
        { "kind": "event", "event": "cart_add", "within_days": 30, "negate": false },
        { "kind": "event", "event": "purchase", "within_days": 30, "negate": true }
      ],
      "must_include": {
        "sms": ["istanbul_cart_no_purchase"],
        "email": ["istanbul_cart_no_purchase", "istanbul_cart_no_purchase_no_sms_consent"]
      },
      "must_exclude": {
        "sms": ["istanbul_cart_purchased", "ankara_cart_no_purchase", "istanbul_cart_no_purchase_no_sms_consent", "istanbul_cart_no_purchase_no_consent"],
        "email": ["istanbul_cart_purchased", "ankara_cart_no_purchase", "istanbul_cart_no_purchase_no_consent"]
      },
      "audience": { "min": 300, "max": 340 },
      "language": "tr",
      "require_variable": "campaign_url"
    }
  },
